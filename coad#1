<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ReportHub — Social Media Report Center</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0f;--surface:#111118;--surface2:#18181f;--border:#2a2a38;--text:#e8e8f0;--muted:#6b6b85;--accent:#ff3c6e;--accent2:#7c3aed;--success:#22c55e;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(124,58,237,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,0.04) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;}
.orb{position:fixed;border-radius:50%;filter:blur(120px);pointer-events:none;z-index:0;}
.orb-1{width:400px;height:400px;background:rgba(255,60,110,0.08);top:-100px;right:-100px;}
.orb-2{width:500px;height:500px;background:rgba(124,58,237,0.07);bottom:-150px;left:-100px;}
.container{max-width:900px;margin:0 auto;padding:0 20px;position:relative;z-index:1;}
header{padding:36px 0 28px;text-align:center;animation:fadeDown 0.6s ease both;}
.logo{display:inline-flex;align-items:center;gap:10px;font-size:12px;font-family:'JetBrains Mono',monospace;color:var(--muted);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:16px;}
.logo-dot{width:7px;height:7px;background:var(--accent);border-radius:50%;animation:pulse 2s ease infinite;}
h1{font-size:clamp(28px,6vw,52px);font-weight:800;line-height:1.05;letter-spacing:-0.02em;background:linear-gradient(135deg,#fff 40%,rgba(255,255,255,0.45));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.subtitle{margin-top:10px;font-size:13px;color:var(--muted);font-family:'JetBrains Mono',monospace;}
.section-label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}
.platforms{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:28px;animation:fadeUp 0.6s 0.1s ease both;}
@media(min-width:560px){.platforms{grid-template-columns:repeat(6,1fr);}}
.platform-btn{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 6px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:7px;transition:all 0.2s;}
.platform-btn:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.18);}
.platform-btn.active{transform:translateY(-2px);box-shadow:0 0 0 2px currentColor,0 8px 24px rgba(0,0,0,0.4);}
.platform-btn[data-p="tiktok"]{color:#ff0050;}.platform-btn[data-p="tiktok"].active{background:rgba(255,0,80,0.12);}
.platform-btn[data-p="instagram"]{color:#e1306c;}.platform-btn[data-p="instagram"].active{background:rgba(225,48,108,0.12);}
.platform-btn[data-p="facebook"]{color:#1877f2;}.platform-btn[data-p="facebook"].active{background:rgba(24,119,242,0.12);}
.platform-btn[data-p="twitter"]{color:#1da1f2;}.platform-btn[data-p="twitter"].active{background:rgba(29,161,242,0.12);}
.platform-btn[data-p="snapchat"]{color:#f5d800;}.platform-btn[data-p="snapchat"].active{background:rgba(255,252,0,0.08);}
.platform-btn[data-p="youtube"]{color:#ff0000;}.platform-btn[data-p="youtube"].active{background:rgba(255,0,0,0.12);}
.platform-btn[data-p="whatsapp"]{color:#25d366;}.platform-btn[data-p="whatsapp"].active{background:rgba(37,211,102,0.12);}
.platform-btn[data-p="bigo"]{color:#f96900;}.platform-btn[data-p="bigo"].active{background:rgba(249,105,0,0.12);}
.platform-btn[data-p="imo"]{color:#0099ff;}.platform-btn[data-p="imo"].active{background:rgba(0,153,255,0.12);}
.platform-btn[data-p="telegram"]{color:#2aabee;}.platform-btn[data-p="telegram"].active{background:rgba(42,171,238,0.12);}
.platform-icon{font-size:26px;}.platform-name{font-size:10px;font-family:'JetBrains Mono',monospace;color:var(--muted);}
.card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:28px;margin-bottom:20px;animation:fadeUp 0.5s ease both;}
.progress-bar{height:3px;background:var(--border);border-radius:99px;margin-bottom:22px;overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px;width:0%;transition:width 0.4s ease;}
.report-types{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:4px;}
@media(min-width:480px){.report-types{grid-template-columns:repeat(3,1fr);}}
.type-btn{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:11px 8px;cursor:pointer;font-family:'Syne',sans-serif;font-size:12px;color:var(--muted);transition:all 0.2s;text-align:center;line-height:1.4;}
.type-btn:hover{border-color:rgba(255,255,255,0.18);color:var(--text);}
.type-btn.active{background:rgba(124,58,237,0.15);border-color:var(--accent2);color:var(--text);}
.type-icon{display:block;font-size:17px;margin-bottom:3px;}
.form-row{display:grid;gap:14px;margin-bottom:14px;}
@media(min-width:560px){.form-row.two{grid-template-columns:1fr 1fr;}}
label{display:block;font-size:11px;font-family:'JetBrains Mono',monospace;letter-spacing:0.14em;text-transform:uppercase;color:var(--muted);margin-bottom:7px;}
input,select,textarea{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--text);font-family:'Syne',sans-serif;font-size:14px;transition:border-color 0.2s,box-shadow 0.2s;outline:none;-webkit-appearance:none;}
input:focus,select:focus,textarea:focus{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(124,58,237,0.15);}
select option{background:#18181f;}
textarea{resize:vertical;min-height:90px;line-height:1.6;}
.char-count{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted);text-align:right;margin-top:4px;}
.guide-panel{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:16px;}
.guide-steps{display:flex;flex-direction:column;gap:10px;}
.guide-step{display:flex;gap:12px;align-items:flex-start;font-size:13px;line-height:1.6;color:var(--muted);}
.step-num{min-width:24px;height:24px;background:rgba(124,58,237,0.2);border:1px solid var(--accent2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--accent2);flex-shrink:0;}
.guide-step strong{color:var(--text);}
.guide-step a{color:var(--accent2);text-decoration:none;}
.guide-step a:hover{text-decoration:underline;}
.copy-box{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px 16px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);white-space:pre-wrap;word-break:break-all;line-height:1.7;position:relative;margin-bottom:16px;}
.copy-btn{position:absolute;top:10px;right:10px;background:rgba(124,58,237,0.2);border:1px solid var(--accent2);border-radius:7px;padding:5px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--accent2);cursor:pointer;transition:all 0.2s;}
.copy-btn:hover{background:rgba(124,58,237,0.35);}
.btn-submit{width:100%;padding:15px;background:linear-gradient(135deg,var(--accent) 0%,var(--accent2) 100%);border:none;border-radius:12px;color:#fff;font-family:'Syne',sans-serif;font-size:15px;font-weight:700;cursor:pointer;letter-spacing:0.04em;transition:all 0.2s;margin-top:4px;}
.btn-submit:hover{transform:translateY(-1px);box-shadow:0 8px 32px rgba(255,60,110,0.3);}
.btn-submit:disabled{opacity:0.5;cursor:not-allowed;transform:none;}
.success-card{background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.22);border-radius:18px;padding:28px;text-align:center;display:none;animation:fadeUp 0.4s ease both;}
.success-card.show{display:block;}
.success-icon{font-size:44px;margin-bottom:10px;}
.success-title{font-size:20px;font-weight:700;color:var(--success);margin-bottom:8px;}
.success-text{font-size:13px;color:var(--muted);line-height:1.7;margin-bottom:18px;}
.success-ref{display:inline-block;margin-bottom:18px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:7px 16px;}
.open-btn{display:inline-block;padding:13px 28px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:10px;color:#fff;font-family:'Syne',sans-serif;font-weight:700;text-decoration:none;font-size:14px;transition:all 0.2s;margin-bottom:14px;}
.open-btn:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(255,60,110,0.3);}
.btn-reset{display:block;margin:0 auto;background:transparent;border:1px solid var(--border);border-radius:10px;padding:9px 22px;color:var(--muted);font-family:'Syne',sans-serif;font-size:13px;cursor:pointer;transition:all 0.2s;}
.btn-reset:hover{border-color:rgba(255,255,255,0.2);color:var(--text);}
.direct-links{animation:fadeUp 0.6s 0.3s ease both;margin-bottom:36px;}
.links-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;}
@media(min-width:560px){.links-grid{grid-template-columns:repeat(3,1fr);}}
.link-card{background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:14px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:9px;font-size:12px;transition:all 0.2s;font-family:'JetBrains Mono',monospace;}
.link-card:hover{border-color:rgba(255,255,255,0.18);transform:translateY(-2px);background:var(--surface2);}
footer{text-align:center;padding:20px 0 36px;font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--muted);position:relative;z-index:1;animation:fadeUp 0.6s 0.4s ease both;}
@keyframes fadeDown{from{opacity:0;transform:translateY(-18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.4;transform:scale(0.75)}}
</style>
</head>
<body>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="container">
  <header>
    <div class="logo"><div class="logo-dot"></div>ReportHub<div class="logo-dot"></div></div>
    <h1>Social Media<br>Report Center</h1>
    <p class="subtitle">// All platforms. One place. Official channels only.</p>
  </header>

  <div style="animation:fadeUp 0.6s 0.08s ease both;">
    <p class="section-label">01 — Choose Platform</p>
    <div class="platforms">
      <button class="platform-btn" data-p="tiktok"    onclick="selectPlatform('tiktok')">   <span class="platform-icon">🎵</span><span class="platform-name">TikTok</span>    </button>
      <button class="platform-btn" data-p="instagram" onclick="selectPlatform('instagram')"><span class="platform-icon">📸</span><span class="platform-name">Instagram</span></button>
      <button class="platform-btn" data-p="facebook"  onclick="selectPlatform('facebook')"> <span class="platform-icon">👥</span><span class="platform-name">Facebook</span>  </button>
      <button class="platform-btn" data-p="twitter"   onclick="selectPlatform('twitter')">  <span class="platform-icon">🐦</span><span class="platform-name">X/Twitter</span> </button>
      <button class="platform-btn" data-p="snapchat"  onclick="selectPlatform('snapchat')"> <span class="platform-icon">👻</span><span class="platform-name">Snapchat</span>  </button>
      <button class="platform-btn" data-p="youtube"   onclick="selectPlatform('youtube')">  <span class="platform-icon">&#x25B6;&#xFE0F;</span><span class="platform-name">YouTube</span></button>
      <button class="platform-btn" data-p="whatsapp"  onclick="selectPlatform('whatsapp')"><span class="platform-icon">💬</span><span class="platform-name">WhatsApp</span></button>
      <button class="platform-btn" data-p="bigo"      onclick="selectPlatform('bigo')">    <span class="platform-icon">📡</span><span class="platform-name">Bigo Live</span> </button>
      <button class="platform-btn" data-p="imo"       onclick="selectPlatform('imo')">     <span class="platform-icon">📲</span><span class="platform-name">IMO</span>       </button>
      <button class="platform-btn" data-p="telegram"  onclick="selectPlatform('telegram')"><span class="platform-icon">✈️</span><span class="platform-name">Telegram</span>  </button>
    </div>
  </div>

  <div id="formSection">
    <div class="card" style="text-align:center;padding:44px 28px;">
      <div style="font-size:38px;margin-bottom:10px;">&#9757;</div>
      <div style="color:var(--muted);font-size:14px;">Select a platform above to begin your report</div>
    </div>
  </div>

  <div class="direct-links">
    <p class="section-label">Official Report Centers — Direct Links</p>
    <div class="links-grid">
      <a class="link-card" href="https://www.tiktok.com/legal/report/feedback" target="_blank" rel="noopener">🎵 TikTok Report</a>
      <a class="link-card" href="https://help.instagram.com/2922067214679225/" target="_blank" rel="noopener">📸 Instagram Report</a>
      <a class="link-card" href="https://www.facebook.com/help/contact/274459462613911" target="_blank" rel="noopener">👥 Facebook Report</a>
      <a class="link-card" href="https://help.twitter.com/en/safety-and-security/report-a-safety-issue" target="_blank" rel="noopener">🐦 X/Twitter Report</a>
      <a class="link-card" href="https://support.snapchat.com/en-US/i-need-help" target="_blank" rel="noopener">👻 Snapchat Report</a>
      <a class="link-card" href="https://support.google.com/youtube/answer/2802027" target="_blank" rel="noopener">&#x25B6;&#xFE0F; YouTube Report</a>
      <a class="link-card" href="https://faq.whatsapp.com/414631957536067/" target="_blank" rel="noopener">💬 WhatsApp Report</a>
      <a class="link-card" href="https://blog.bigo.tv/support/" target="_blank" rel="noopener">📡 Bigo Live Report</a>
      <a class="link-card" href="https://imo.im/en/faq/How-will-imo-deal-with-the-violations-I-report" target="_blank" rel="noopener">📲 IMO Report</a>
      <a class="link-card" href="https://telegram.org/faq_spam" target="_blank" rel="noopener">✈️ Telegram Report</a>
    </div>
  </div>

  <footer>
    ReportHub — Not affiliated with any social media platform<br>
    All reports submitted through each platform's official reporting channel
  </footer>
</div>

<script>
const platforms = {
  tiktok:{
    name:'TikTok',icon:'🎵',
    reportUrl:'https://www.tiktok.com/legal/report/feedback',
    steps:[
      {text:'<strong>Log in</strong> to your TikTok account at <a href="https://www.tiktok.com" target="_blank">tiktok.com</a>'},
      {text:'Go to the <strong>video, comment, or profile</strong> you want to report'},
      {text:'Tap the <strong>Share button &#8594; Report</strong> — or click the button below to open TikTok\'s official report page'},
      {text:'<strong>Paste the copied details</strong> into their form and submit — TikTok reviews within 24&#8211;72 hrs'},
    ],
    types:[{icon:'🔞',label:'Nudity / Sexual'},{icon:'😤',label:'Harassment'},{icon:'🔫',label:'Violence / Threats'},{icon:'🤥',label:'Misinformation'},{icon:'🚫',label:'Spam / Scam'},{icon:'⚠️',label:'Other Violation'}]
  },
  instagram:{
    name:'Instagram',icon:'📸',
    reportUrl:'https://help.instagram.com/2922067214679225/',
    steps:[
      {text:'<strong>Log in</strong> to Instagram at <a href="https://www.instagram.com" target="_blank">instagram.com</a> or open the app'},
      {text:'Find the <strong>post, story, reel, or profile</strong> you want to report'},
      {text:'Tap the <strong>&#8943; menu &#8594; Report</strong> — or use the official form link below'},
      {text:'<strong>Paste the copied details</strong> and complete the submission'},
    ],
    types:[{icon:'🔞',label:'Nudity / Sexual'},{icon:'😤',label:'Harassment'},{icon:'🔫',label:'Violence'},{icon:'🤥',label:'False Info'},{icon:'🚫',label:'Spam'},{icon:'©️',label:'Copyright'}]
  },
  facebook:{
    name:'Facebook',icon:'👥',
    reportUrl:'https://www.facebook.com/help/contact/274459462613911',
    steps:[
      {text:'<strong>Log in</strong> to Facebook at <a href="https://www.facebook.com" target="_blank">facebook.com</a> or open the app'},
      {text:'Go to the <strong>post, group, page, or profile</strong> you want to report'},
      {text:'Click the <strong>&#8943; menu &#8594; Find support or report</strong> — or use the link below'},
      {text:'<strong>Paste your details</strong> and submit to Facebook\'s review team'},
    ],
    types:[{icon:'🔞',label:'Nudity / Sexual'},{icon:'😤',label:'Harassment / Bullying'},{icon:'🔫',label:'Violence / Hate'},{icon:'🤥',label:'Misinformation'},{icon:'🚫',label:'Spam / Fake'},{icon:'⚠️',label:'Impersonation'}]
  },
  twitter:{
    name:'X / Twitter',icon:'🐦',
    reportUrl:'https://help.twitter.com/en/safety-and-security/report-a-safety-issue',
    steps:[
      {text:'<strong>Log in</strong> to X at <a href="https://www.x.com" target="_blank">x.com</a> (formerly Twitter)'},
      {text:'Find the <strong>post or account</strong> you want to report'},
      {text:'Click the <strong>&#8943; menu &#8594; Report post / Report account</strong> — or use the safety link below'},
      {text:'<strong>Paste your description</strong> and submit — X\'s Safety team will review it'},
    ],
    types:[{icon:'😤',label:'Harassment / Hate'},{icon:'🔞',label:'Nudity / NSFW'},{icon:'🔫',label:'Violence / Threats'},{icon:'🤥',label:'Misleading Info'},{icon:'🚫',label:'Spam / Bot'},{icon:'⚠️',label:'Impersonation'}]
  },
  snapchat:{
    name:'Snapchat',icon:'👻',
    reportUrl:'https://support.snapchat.com/en-US/i-need-help',
    steps:[
      {text:'<strong>Open Snapchat</strong> on your phone or go to <a href="https://www.snapchat.com" target="_blank">snapchat.com</a>'},
      {text:'Find the <strong>snap, story, or profile</strong> you want to report'},
      {text:'Press and <strong>hold the snap &#8594; Report</strong> — or use the support link below'},
      {text:'<strong>Paste your details</strong> and submit — Snapchat reviews all reports'},
    ],
    types:[{icon:'🔞',label:'Nudity / Sexual'},{icon:'😤',label:'Harassment / Bullying'},{icon:'🔫',label:'Violence / Self-Harm'},{icon:'🚫',label:'Spam / Scam'},{icon:'💊',label:'Drug Content'},{icon:'⚠️',label:'Other Issue'}]
  },
  youtube:{
    name:'YouTube',icon:'▶️',
    reportUrl:'https://support.google.com/youtube/answer/2802027',
    steps:[
      {text:'<strong>Log in</strong> to YouTube at <a href="https://www.youtube.com" target="_blank">youtube.com</a>'},
      {text:'Go to the <strong>video, comment, or channel</strong> you want to report'},
      {text:'Click <strong>&#8943; More &#8594; Report</strong> under the video — or use the official link below'},
      {text:'<strong>Paste your details</strong> and submit to YouTube\'s moderation team'},
    ],
    types:[{icon:'🔞',label:'Nudity / Sexual'},{icon:'😤',label:'Harassment / Hate'},{icon:'🔫',label:'Violence / Graphic'},{icon:'🤥',label:'Misinformation'},{icon:'🚫',label:'Spam / Misleading'},{icon:'©️',label:'Copyright / IP'}]
  }
};

let sel=null,selType=null;

function selectPlatform(p){
  sel=p;selType=null;
  document.querySelectorAll('.platform-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('[data-p="'+p+'"]').classList.add('active');
  renderForm(p);
}

function selectType(i){
  selType=i;
  document.querySelectorAll('.type-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.type-btn')[i].classList.add('active');
  updateProgress();
}

function updateProgress(){
  let pct=0;
  if(sel)pct+=30;
  if(selType!==null)pct+=25;
  const u=document.getElementById('contentUrl');
  if(u&&u.value.trim())pct+=20;
  const d=document.getElementById('description');
  if(d&&d.value.trim().length>10)pct+=25;
  const f=document.getElementById('progressFill');
  if(f)f.style.width=pct+'%';
}
